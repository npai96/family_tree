# Set in Render's environment settings, never commit real credentials.
APP_ENV=production
ENABLE_REVIEW_AUTH=false
POSTGRES_RUNTIME_ENABLED=true
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SB_SECRET_KEY
PUBLIC_APP_URL=https://YOUR-SERVICE.onrender.com
SUPABASE_STORAGE_BUCKET=family-media
MAX_MEDIA_UPLOAD_BYTES=5242880
